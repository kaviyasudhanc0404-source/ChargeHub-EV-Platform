# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins, e.g. http://localhost:8080,https://chargehub.vercel.app
FRONTEND_URL=http://localhost:8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/chargehub?retryWrites=true&w=majority

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=<long-random-string>
JWT_EXPIRE=7d

# Email for booking OTPs, sent through Brevo's API
#   BREVO_API_KEY = Brevo → SMTP & API → API keys (Restricted, Transactional email: All)
#   EMAIL_FROM    = a sender verified in Brevo → Senders, domains, IPs
BREVO_API_KEY=<brevo-api-key>
EMAIL_FROM=<verified-sender@example.com>

# Firebase project used for Google sign-in (ID tokens are verified against it)
FIREBASE_PROJECT_ID=<firebase-project-id>

# Gemini API for the "Ask Me" assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouteService (road distances; free key at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=<openrouteservice-key>

# Optional: OSRM server used when OpenRouteService is unavailable (defaults to the free public demo server)
# OSRM_URL=https://router.project-osrm.org
